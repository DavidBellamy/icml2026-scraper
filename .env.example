# Copy to .env and fill in. .env is git-ignored.
# All optional — only needed for the stages you run.

# OpenReview (main-conference PDFs + workshop papers via API)
export OPENREVIEW_USERNAME='you@example.com'
export OPENREVIEW_PASSWORD='...'

# ICML attendee session cookie (unlocks login-gated workshop schedules).
# Get it: log into icml.cc -> DevTools -> Application -> Cookies -> icml.cc -> copy `sessionid`.
export ICML_SESSIONID='...'

# HuggingFace write token (to push the dataset). https://huggingface.co/settings/tokens
export HF_TOKEN='hf_...'
